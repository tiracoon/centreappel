@inherits LayoutComponentBase

<div class="page">
    <div class="top-row px-4">
        <span class="app-title">@Localizer["App_Nom"]</span>

        <AuthorizeView Context="authContext">
            <Authorized>
                <div class="top-row-actions">
                    <a href="#"><span class="bi bi-question" aria-hidden="true"></span> @Localizer["MainLayout_Aide"]</a>
                    <span class="separator">·</span>
                    <span class="operateur-connecte">
                        <span class="bi bi-person-fill" aria-hidden="true"></span>
                        @authContext.User.FindFirst("login_ad")?.Value
                    </span>
                    <span class="separator">·</span>
                    <EditForm Model="Model" FormName="DeconnexionForm" OnValidSubmit="OnDeconnexionAsync" method="post">
                        <button type="submit" class="btn-link">@Localizer["MainLayout_Deconnexion"]</button>
                    </EditForm>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <AuthorizeView>
        <Authorized>
            <MenuHorizontal />
        </Authorized>
    </AuthorizeView>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["MainLayout_ErreurNonGeree"]
    <a href="." class="reload">@Localizer["MainLayout_Recharger"]</a>
    <span class="dismiss">🗙</span>
</div>
