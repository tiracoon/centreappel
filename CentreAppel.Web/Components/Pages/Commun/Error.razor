@page "/Error"
@attribute [AllowAnonymous]
@inherits LocalizedPage

<PageTitle>@Localizer["Error_PageTitle"]</PageTitle>

<h1 class="text-danger">@Localizer["Error_Titre"]</h1>
<h2 class="text-danger">@Localizer["Error_Message"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestIdLabel"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["Error_ModeDeveloppementTitre"]</h3>
<p>
    @Localizer["Error_ModeDeveloppementTexte1"]
</p>
<p>
    <strong>@Localizer["Error_ModeDeveloppementAvertissement"]</strong>
    @Localizer["Error_ModeDeveloppementTexte2"]
</p>
