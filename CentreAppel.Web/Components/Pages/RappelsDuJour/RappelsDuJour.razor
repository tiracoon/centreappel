@page "/rappels-du-jour"
@rendermode InteractiveServer
@inherits LocalizedPage

<PageTitle>@Localizer["RappelsDuJour_PageTitle"]</PageTitle>

<h1 class="page-title">@Localizer["RappelsDuJour_PageTitle"]</h1>

<p class="page-subtitle">@string.Format(Localizer["RappelsDuJour_Compteur"], Rappels.Count) · @Localizer["RappelsDuJour_Portee"]</p>

<div class="data-table-scroll">
    <table class="table rappels-table">
        <thead>
            <tr>
                <th>@Localizer["RappelsDuJour_ColonneCampagne"]</th>
                <th>@Localizer["RappelsDuJour_ColonneRaisonSociale"]</th>
                <th>@Localizer["RappelsDuJour_ColonneTelephone"]</th>
                <th>@Localizer["RappelsDuJour_ColonneDateRelance"]</th>
                <th>@Localizer["RappelsDuJour_ColonneDerniereAction"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Rappels.Count == 0)
            {
                <tr><td colspan="6"><em>@Localizer["RappelsDuJour_Aucun"]</em></td></tr>
            }
            else
            {
                @foreach (var rappel in Rappels)
                {
                    <tr @key="rappel.IdLCampagne">
                        <td>@rappel.NomCampagne</td>
                        <td>@rappel.RaisonSociale</td>
                        <td>@rappel.Telephone</td>
                        <td class="@(EstEnRetard(rappel) ? "text-danger" : null)">
                            @DateRelanceAffichee(rappel)
                            @if (EstEnRetard(rappel))
                            {
                                <text> @Localizer["RappelsDuJour_EnRetard"]</text>
                            }
                        </td>
                        <td>@Localizer["Deroulement_A_RAPPELER"] — @rappel.LoginOperateurDerniereAction</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnHandleAsync(rappel)">
                                @Localizer["RappelsDuJour_Traiter"]
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="info-note">
    <span class="bi bi-info-circle" aria-hidden="true"></span>
    @Localizer["RappelsDuJour_Note"]
</p>

@if (IdLCampagnePopupOuverte is not null)
{
    <PopupSaisieAction IdLCampagne="IdLCampagnePopupOuverte" Mode="ModePopup" OnClose="OnPopupClosedAsync" OnSave="OnPopupSavedAsync" />
}
